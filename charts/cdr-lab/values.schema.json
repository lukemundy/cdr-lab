{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The values of a brand have only its deployment settings and its seed customers. The chart gives the fields of its Register record. A seed customer has the fields of the customer load file of the data holder, and the data holder checks their values.",
  "type": "object",
  "properties": {
    "brands": {
      "type": "object",
      "additionalProperties": {
        "type": ["object", "null"],
        "additionalProperties": false,
        "properties": {
          "public": { "$ref": "#/$defs/listener" },
          "secure": { "$ref": "#/$defs/listener" },
          "bankSite": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "host": { "type": "string" },
              "port": { "$ref": "#/$defs/port" }
            }
          },
          "internal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowedHosts": { "type": "array", "items": { "type": "string" } }
            }
          },
          "console": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" }
            }
          },
          "database": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "ownerSecret": { "type": "string" },
              "serviceSecret": { "type": "string" }
            }
          },
          "mail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "smtpAddress": { "type": "string" },
              "from": { "type": "string" }
            }
          },
          "customers": { "type": "array", "items": { "$ref": "#/$defs/customer" } }
        }
      }
    },
    "register": {
      "type": "object",
      "properties": {
        "public": { "$ref": "#/$defs/listener" },
        "secure": { "$ref": "#/$defs/listener" }
      }
    }
  },
  "$defs": {
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastName", "emailAddress"],
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "emailAddress": { "type": "string" },
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/account" } }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "accountNumber"],
      "properties": {
        "productId": { "type": "string" },
        "accountNumber": { "type": "string" },
        "displayName": { "type": "string" },
        "creditLimit": { "type": "string" },
        "openStatus": { "type": "string" },
        "transactions": { "type": "array", "items": { "$ref": "#/$defs/transaction" } }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "description", "amount", "age"],
      "properties": {
        "type": { "type": "string" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "string" },
        "reference": { "type": "string" },
        "merchantName": { "type": "string" },
        "merchantCategoryCode": { "type": "string" },
        "billerCode": { "type": "string" },
        "billerName": { "type": "string" },
        "crn": { "type": "string" },
        "apcaNumber": { "type": "string" },
        "extendedData": { "type": "object" },
        "age": { "type": "string" }
      }
    },
    "port": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 65535
    },
    "listener": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "$ref": "#/$defs/port" }
      }
    }
  }
}
