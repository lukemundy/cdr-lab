{
  "name": "cdr-lab-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "fmt": "oxfmt",
    "lint": "tsc --noEmit && for app in apps/*/; do tsc --noEmit -p \"$app\" || exit 1; done && oxlint && oxfmt --check && node packages/tokens/src/check-token-use.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.0.5",
    "oxfmt": "0.80.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
